# ============================================================
# LASTMILE AI - REAL-TIME EVENT STREAMING CONFIGURATION
# Condense + Apache Kafka Configuration
# ============================================================

# Kafka Broker / Condense Managed Cluster Endpoint
# For local Kafka / Redpanda: localhost:9092
# For Condense Cloud: cluster-xxxx.condense.io:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security Protocol: PLAINTEXT, SASL_SSL, SASL_PLAINTEXT, SSL
# Use PLAINTEXT for local development without TLS.
# Use SASL_SSL for Condense Cloud and managed cloud Kafka.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL Mechanism: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512
KAFKA_SASL_MECHANISM=PLAIN

# Credentials (Condense API Key & Secret)
KAFKA_SASL_USERNAME=your_condense_api_key
KAFKA_SASL_PASSWORD=your_condense_api_secret
CONDENSE_API_KEY=your_condense_api_key
CONDENSE_API_SECRET=your_condense_api_secret

# Consumer & Client Identifiers
KAFKA_CLIENT_ID=lastmile-node
KAFKA_CONSUMER_GROUP=lastmile-backend-group
KAFKA_AUTO_OFFSET_RESET=latest

# Streaming Mode: 'auto' (connects to Kafka, falls back to memory if unreachable),
# 'kafka' (strict Kafka required), 'inmemory' (local test/dev without Kafka)
STREAMING_MODE=auto
